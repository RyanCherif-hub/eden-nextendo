From: RyanCherif-hub <noreply@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:22:38 +0100
Subject: [PATCH] Nextendo: working ssl:s contexts and Nextendo account id

ssl:s CreateContext/CreateContextForSystem now return a real ISslContext
(ACNH opens its HTTPS connections through it), CreateConnectionEx added,
GetAccountId reports the linked Nextendo pid.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WPxeWxr692dY99HZxM8fWB
---
 src/core/hle/service/acc/acc.cpp            |  7 +++-
 src/core/hle/service/acc/nextendo_token.cpp | 12 ++++++
 src/core/hle/service/acc/nextendo_token.h   |  3 ++
 src/core/hle/service/ssl/ssl.cpp            | 41 ++++++++++++++-------
 4 files changed, 48 insertions(+), 15 deletions(-)

diff --git a/src/core/hle/service/acc/acc.cpp b/src/core/hle/service/acc/acc.cpp
index cc0c3c7..2e099f4 100644
--- a/src/core/hle/service/acc/acc.cpp
+++ b/src/core/hle/service/acc/acc.cpp
@@ -714,11 +714,16 @@ private:
     }
 
     void GetAccountId(HLERequestContext& ctx) {
+        // Nextendo port: online services know the player by their Nextendo pid.
+        u64 account_id = Nextendo::GetLinkedPid();
+        if (account_id == 0) {
+            account_id = profile_manager->GetLastOpenedUser().Hash();
+        }
         LOG_DEBUG(Service_ACC, "called");
 
         IPC::ResponseBuilder rb{ctx, 4};
         rb.Push(ResultSuccess);
-        rb.PushRaw<u64>(profile_manager->GetLastOpenedUser().Hash());
+        rb.PushRaw<u64>(account_id);
     }
 
     void EnsureIdTokenCacheAsync(HLERequestContext& ctx) {
diff --git a/src/core/hle/service/acc/nextendo_token.cpp b/src/core/hle/service/acc/nextendo_token.cpp
index 9603366..c5b0844 100644
--- a/src/core/hle/service/acc/nextendo_token.cpp
+++ b/src/core/hle/service/acc/nextendo_token.cpp
@@ -310,6 +310,18 @@ std::vector<u8> GetIdTokenBytes(Core::System& system) {
     return cached;
 }
 
+u64 GetLinkedPid() {
+    static const u64 pid = [] {
+        const AccountInfo account = LoadAccount();
+        try {
+            return account.pid.empty() ? u64{0} : static_cast<u64>(std::stoull(account.pid));
+        } catch (...) {
+            return u64{0};
+        }
+    }();
+    return pid;
+}
+
 void WriteIdToken(HLERequestContext& ctx, const std::vector<u8>& token) {
     const std::size_t capacity = ctx.GetWriteBufferSize();
     if (capacity == 0) {
diff --git a/src/core/hle/service/acc/nextendo_token.h b/src/core/hle/service/acc/nextendo_token.h
index e219521..c15818b 100644
--- a/src/core/hle/service/acc/nextendo_token.h
+++ b/src/core/hle/service/acc/nextendo_token.h
@@ -25,6 +25,9 @@ namespace Service::Account::Nextendo {
 // Nextendo server checks.
 std::vector<u8> GetIdTokenBytes(Core::System& system);
 
+// The linked Nextendo account id (pid), or 0 when no account file was found.
+u64 GetLinkedPid();
+
 // Titles read the token as a C string: zero the rest of their buffer.
 void WriteIdToken(HLERequestContext& ctx, const std::vector<u8>& token);
 

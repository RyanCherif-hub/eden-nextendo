+namespace Service::Account::Nextendo {
+
+namespace {
+
+constexpr const char* BaasIssuer = "https://e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com";
+constexpr const char* BaasJku =
+    "https://e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com/1.0.0/certificates";
+constexpr const char* BaasAudience = "ed9e2f05d286f7b8";
+constexpr const char* BaasKeyId = "nextendo-baas-key-1";
+
+// ---- Nextendo account (pid / token), same file format as citron-nextendo ----------------
+
+struct AccountInfo {
+    std::string pid;
+    std::string token;
+};
+
+void ParseAccountFile(const std::string& contents, AccountInfo& out) {
+    std::size_t start = 0;
+    while (start < contents.size()) {
+        std::size_t end = contents.find('\n', start);
+        if (end == std::string::npos) {
+            end = contents.size();
+        }
+        std::string line = contents.substr(start, end - start);
+        if (!line.empty() && line.back() == '\r') {
+            line.pop_back();
+        }
+        const auto eq = line.find('=');
+        if (eq != std::string::npos) {
+            const std::string key = line.substr(0, eq);
+            const std::string value = line.substr(eq + 1);
+            if (key == "pid") {
+                out.pid = value;
+            } else if (key == "token") {
+                out.token = value;
+            }
+        }
+        start = end + 1;
+    }
+}
+
+// Reads <eden config>/nextendo_account.txt, else Citron-Nextendo's own copy
+// (%APPDATA%/citron/config/nextendo_account.txt), so signing in once in Citron is enough.
+AccountInfo LoadAccount() {
+    AccountInfo info;
+    std::vector<std::filesystem::path> candidates;
+    candidates.push_back(Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir) /
+                         "nextendo_account.txt");
+    candidates.push_back(Common::FS::GetLegacyPath(Common::FS::EmuPath::CitronConfigDir) /
+                         "nextendo_account.txt");
+#ifdef _WIN32
+    if (const char* appdata = std::getenv("APPDATA"); appdata && *appdata) {
+        candidates.push_back(std::filesystem::path{appdata} / "citron" / "config" /
+                             "nextendo_account.txt");
+    }
+#endif
+    for (const auto& path : candidates) {
+        const std::string contents =
+            Common::FS::ReadStringFromFile(path, Common::FS::FileType::TextFile);
+        if (contents.empty()) {
+            continue;
+        }
+        ParseAccountFile(contents, info);
+        if (!info.token.empty() || !info.pid.empty()) {
+            LOG_INFO(Service_ACC, "[Nextendo] Account loaded from {} (pid={}, token={})",
+                     path.string(), info.pid, info.token.empty() ? "missing" : "present");
+            return info;
+        }
+    }
+    LOG_WARNING(Service_ACC,
+                "[Nextendo] No nextendo_account.txt found; sign in once in Citron-Nextendo or "
+                "copy the file into Eden's config folder");
+    return info;
+}
+
+// ---- JWT helpers --------------------------------------------------------------------------
+
+std::string Base64UrlEncode(std::span<const u8> data) {
+    static constexpr std::string_view alphabet =
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    std::string out;
+    out.reserve((data.size() + 2) / 3 * 4);
+    for (std::size_t i = 0; i < data.size(); i += 3) {
+        const u32 remaining = static_cast<u32>(data.size() - i);
+        const u32 triple = (static_cast<u32>(data[i]) << 16) |
+                           (remaining > 1 ? static_cast<u32>(data[i + 1]) << 8 : 0) |
+                           (remaining > 2 ? static_cast<u32>(data[i + 2]) : 0);
+        out += alphabet[(triple >> 18) & 0x3F];
+        out += alphabet[(triple >> 12) & 0x3F];
+        if (remaining > 1) {
+            out += alphabet[(triple >> 6) & 0x3F];
+        }
+        if (remaining > 2) {
+            out += alphabet[triple & 0x3F];
+        }
+    }
+    return out;
+}
+
+std::string Base64UrlEncode(std::string_view text) {
+    return Base64UrlEncode(std::span{reinterpret_cast<const u8*>(text.data()), text.size()});
+}
+
+std::string RandomHex(std::size_t bytes) {
+    std::vector<u8> buffer(bytes);
+    if (RAND_bytes(buffer.data(), static_cast<int>(buffer.size())) != 1) {
+        for (auto& b : buffer) {
+            b = static_cast<u8>(std::rand());
+        }
+    }
+    return Common::HexToString(buffer, /*upper=*/false);
+}
+
+EVP_PKEY* LoadPem(const std::string& pem) {
+    BIO* bio = BIO_new_mem_buf(pem.data(), static_cast<int>(pem.size()));
+    if (!bio) {
+        return nullptr;
+    }
+    EVP_PKEY* key = PEM_read_bio_PrivateKey(bio, nullptr, nullptr, nullptr);
+    BIO_free(bio);
+    return key;
+}
+
+EVP_PKEY* GenerateRsaKey() {
+    EVP_PKEY_CTX* kctx = EVP_PKEY_CTX_new_id(EVP_PKEY_RSA, nullptr);
+    if (!kctx) {
+        return nullptr;
+    }
+    EVP_PKEY* key = nullptr;
+    if (EVP_PKEY_keygen_init(kctx) <= 0 || EVP_PKEY_CTX_set_rsa_keygen_bits(kctx, 2048) <= 0 ||
+        EVP_PKEY_keygen(kctx, &key) <= 0) {
+        key = nullptr;
+    }
+    EVP_PKEY_CTX_free(kctx);
+    return key;
+}
+
+// A key that stays the same across launches (persisted in Eden's keys folder).
+EVP_PKEY* GetSigningKey() {
+    static EVP_PKEY* key = []() -> EVP_PKEY* {
+        if (const char* env = std::getenv("NEXTENDO_BAAS_SIGNING_KEY"); env && *env) {
+            if (EVP_PKEY* k = LoadPem(env)) {
+                return k;
+            }
+        }
+        const auto path =
+            Common::FS::GetEdenPath(Common::FS::EdenPath::KeysDir) / "nextendo_baas_auto.pem";
+        const std::string existing =
+            Common::FS::ReadStringFromFile(path, Common::FS::FileType::TextFile);
+        if (existing.find("BEGIN") != std::string::npos) {
+            if (EVP_PKEY* k = LoadPem(existing)) {
+                return k;
+            }
+        }
+        EVP_PKEY* generated = GenerateRsaKey();
+        if (!generated) {
+            LOG_ERROR(Service_ACC, "[Nextendo] Failed to generate a BAAS signing key");
+            return nullptr;
+        }
+        BIO* out = BIO_new(BIO_s_mem());
+        if (out && PEM_write_bio_PrivateKey(out, generated, nullptr, nullptr, 0, nullptr,
+                                            nullptr)) {
+            char* data = nullptr;
+            const long len = BIO_get_mem_data(out, &data);
+            if (len > 0 && data) {
+                void(Common::FS::CreateParentDirs(path));
+                void(Common::FS::WriteStringToFile(path, Common::FS::FileType::TextFile,
+                                                   std::string_view{data, std::size_t(len)}));
+            }
+        }
+        if (out) {
+            BIO_free(out);
+        }
+        return generated;
+    }();
+    return key;
+}
+
+std::string SignRs256(std::string_view input) {
+    EVP_PKEY* key = GetSigningKey();
+    if (!key) {
+        return {};
+    }
+    EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+    if (!ctx) {
+        return {};
+    }
+    std::string signature;
+    std::size_t length = 0;
+    const auto* data = reinterpret_cast<const unsigned char*>(input.data());
+    if (EVP_DigestSignInit(ctx, nullptr, EVP_sha256(), nullptr, key) == 1 &&
+        EVP_DigestSign(ctx, nullptr, &length, data, input.size()) == 1) {
+        std::vector<u8> raw(length);
+        if (EVP_DigestSign(ctx, raw.data(), &length, data, input.size()) == 1) {
+            raw.resize(length);
+            signature = Base64UrlEncode(raw);
+        }
+    }
+    EVP_MD_CTX_free(ctx);
+    if (signature.empty()) {
+        LOG_ERROR(Service_ACC, "[Nextendo] Failed to sign the BAAS id_token");
+    }
+    return signature;
+}
+
+std::string GetInstalledTitleVersion(Core::System& system, u64 program_id) {
+    if (program_id == 0) {
+        return {};
+    }
+    const FileSys::PatchManager pm{program_id, system.GetFileSystemController(),
+                                   system.GetContentProvider()};
+    const auto metadata = pm.GetControlMetadata();
+    return metadata.first != nullptr ? metadata.first->GetVersionString() : std::string{};
+}
+
+std::string BuildIdToken(const AccountInfo& account, const std::string& installed_version) {
+    const auto now = std::chrono::duration_cast<std::chrono::seconds>(
+                         std::chrono::system_clock::now().time_since_epoch())
+                         .count();
+
+    const std::string header = fmt::format(
+        R"({{"alg":"RS256","kid":"{}","typ":"id_token","jku":"{}"}})", BaasKeyId, BaasJku);
+
+    std::string nnex_claim;
+    if (!account.token.empty()) {
+        nnex_claim = fmt::format(R"("nnex":"{}",)", account.token);
+    } else if (!account.pid.empty()) {
+        nnex_claim = fmt::format(R"("npid":"{}",)", account.pid);
+    }
+
+    const std::string device_id = RandomHex(0x10);
+    const std::string nintendo_claim = fmt::format(
+        R"("nintendo":{{"dt":"NX Prod 1","pc":"HAC","di":"{}","sn":"XAW10000000000","ist":false}},)",
+        device_id);
+
+    std::string tv_claim;
+    if (!installed_version.empty()) {
+        tv_claim = fmt::format(R"("tv":"{}",)", installed_version);
+    }
+
+    const std::string payload = fmt::format(
+        R"({{"sub":"{}","aud":"{}","iss":"{}","typ":"id_token","iat":{},"exp":{},"jku":"{}",)"
+        R"("jti":"{}","di":"{}","sn":"XAW10000000000","bs:did":"{}",{}{}{}"hm":true}})",
+        RandomHex(0x10), BaasAudience, BaasIssuer, now, now + 3 * 60 * 60, BaasJku,
+        Common::UUID::MakeRandom().FormattedString(), device_id, RandomHex(0x10),
+        nintendo_claim, nnex_claim, tv_claim);
+
+    const std::string signing_input = Base64UrlEncode(header) + "." + Base64UrlEncode(payload);
+    return signing_input + "." + SignRs256(signing_input);
+}
+
+} // Anonymous namespace
+
+std::vector<u8> GetIdTokenBytes(Core::System& system) {
+    static std::mutex mutex;
+    static std::vector<u8> cached;
+    static std::chrono::steady_clock::time_point expiry{};
+    static u64 cached_program_id = 0;
+
+    std::lock_guard lock{mutex};
+    const u64 program_id = system.GetApplicationProcessProgramID();
+    const auto now = std::chrono::steady_clock::now();
+    if (cached.empty() || now >= expiry || program_id != cached_program_id) {
+        const AccountInfo account = LoadAccount();
+        const std::string token =
+            BuildIdToken(account, GetInstalledTitleVersion(system, program_id));
+        cached.assign(token.begin(), token.end());
+        expiry = now + std::chrono::hours{2};
+        cached_program_id = program_id;
+        LOG_INFO(Service_ACC, "[Nextendo] Issued a signed BAAS id_token ({} bytes)",
+                 cached.size());
+    }
+    return cached;
+}
+
+void WriteIdToken(HLERequestContext& ctx, const std::vector<u8>& token) {
+    const std::size_t capacity = ctx.GetWriteBufferSize();
+    if (capacity == 0) {
+        return;
+    }
+    std::vector<u8> out(capacity, 0);
+    std::memcpy(out.data(), token.data(), std::min(token.size(), capacity));
+    ctx.WriteBuffer(out);
+}
+
+} // namespace Service::Account::Nextendo

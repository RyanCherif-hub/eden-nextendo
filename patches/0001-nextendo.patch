+// ---------------------------------------------------------------------------
+// Nextendo port (logic from citron-nextendo, GPL-3.0).
+// On by default in this build. Set NEXTENDO_ENABLE=0 to turn it off.
+// Override servers with NEXTENDO_SERVER_IP / NEXTENDO_NAT_IP.
+// ---------------------------------------------------------------------------
+static bool NextendoActive() {
+    const char* env = std::getenv("NEXTENDO_ENABLE");
+    if (env == nullptr || *env == '\0') {
+        return true;
+    }
+    const std::string v = Common::ToLower(env);
+    return v != "0" && v != "false" && v != "no" && v != "off";
+}
+
+static std::string NextendoIp(const char* env_var, const char* fallback) {
+    if (const char* env = std::getenv(env_var); env && *env) {
+        return env;
+    }
+    return fallback;
+}
+
+static void NextendoNormalizeHost(std::string& host) {
+    const auto pos = host.find('%');
+    if (pos != std::string::npos) {
+        host.replace(pos, 1, "lp1");
+    }
+    if (host == "api.accounts.nintendo.com" || host == "accounts.nintendo.com") {
+        host = "e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com";
+    }
+}
+
+static std::optional<std::string> GetNextendoRedirectIp(const std::string& host) {
+    if (!NextendoActive()) {
+        return std::nullopt;
+    }
+    const std::string server_ip = NextendoIp("NEXTENDO_SERVER_IP", "51.178.29.194");
+    const std::string nat_ip = NextendoIp("NEXTENDO_NAT_IP", "164.132.111.120");
